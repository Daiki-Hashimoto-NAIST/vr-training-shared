# Local agent/editor tooling
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/vr-training-game-design/
!.agents/skills/vr-training-game-design/**
.codex/
.uloop/
tmp/
0.001f
TempAssembly.dll

# Local Unity automation credentials
Assets/Resources/DevAgentSettings.asset
Assets/Resources/DevAgentSettings.asset.meta

# Unity recovery data is machine-local
Assets/_Recovery/
Assets/_Recovery.meta

# Duplicate Movement sample copy. The canonical imported sample is under Assets/Samples/.
Assets/Scenes/Body Tracking Samples/
Assets/Scenes/Body Tracking Samples.meta

# Player builds and the folders Unity writes beside them. The APK is large,
# changes wholesale every build, and can be rebuilt from the commit it came
# from, so it is not worth a place in history.
*.apk
*.aab
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Written by the Unity Performance Testing package on each run.
Assets/Resources/PerformanceTestRunInfo.json
Assets/Resources/PerformanceTestRunInfo.json.meta
Assets/Resources/PerformanceTestRunSettings.json
Assets/Resources/PerformanceTestRunSettings.json.meta

# Regenerated by the Meta SDK whenever it needs it.
Assets/Resources/OVRBuildConfig.asset
Assets/Resources/OVRBuildConfig.asset.meta

.utmp/

# Portfolio export: local tooling and source assets are not published.
.agents/
.claude/
*.slnx
.env
.env.*
*.keystore
*.jks
*.pem
*.p12
