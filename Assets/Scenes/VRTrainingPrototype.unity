  m_Script: {fileID: 11500000, guid: bbcd0b7874515784e90adaa178e288d2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IVRC.AudienceCallController
  _gameFlow: {fileID: 1945693220}
  _posingScorer: {fileID: 1776370000}
  _viewer: {fileID: 747421260}
  _calls:
  - Text: "87\u756A\u3001\u30C7\u30AB\u3044\uFF01\u30C7\u30AB\u3059\u304E\u308B\uFF01"
    AudioClip: {fileID: 8300000, guid: c592f5f0f61430a41ad13f753c88b1a3, type: 3}
    Volume: 0.85
  - Text: "\u3088\u3063!\u963F\u4FEE\u7F85\u50CF\u30C3\u30C3!!!"
    AudioClip: {fileID: 8300000, guid: 021c90e4b4f0ae649ba98b387e8bb649, type: 3}
    Volume: 0.85
  - Text: "\u30AD\u30EC\u3066\u308B\u3088\uFF01"
    AudioClip: {fileID: 8300000, guid: 6139811f99cc5714397dde0ad4b0051b, type: 3}
    Volume: 0.85
  - Text: "\u30CA\u30A4\u30B9\u30D0\u30EB\u30AF\uFF01"
    AudioClip: {fileID: 8300000, guid: 031c3f1bf8b47d14a80207967ca91149, type: 3}
    Volume: 0.85
  - Text: "\u4E0A\u8155\u4E8C\u982D\u7B4B\u3001\u30C1\u30E7\u30E2\u30E9\u30F3\u30DE!!"
    AudioClip: {fileID: 8300000, guid: 533167e64ec0111469b4908a4c5cd0fa, type: 3}
    Volume: 0.85
  - Text: "\u4E16\u754C\u4E00 \u30CE\u30FC\u30D9\u30EB\u7B4B\u8089\u8CDE\u30C3!!!"
    AudioClip: {fileID: 8300000, guid: a85e1d8f4c0eab842b2a2a46f50e8682, type: 3}
    Volume: 0.85
  - Text: "\u4ED5\u4E0A\u304C\u3063\u3066\u308B\u3088!"
    AudioClip: {fileID: 8300000, guid: c28594a1915458b44acff5e9365a0d4d, type: 3}
    Volume: 0.85
  - Text: "\u63A1\u308C\u305F\u3066\u65B0\u9BAE \u80A9\u30E1\u30ED\u30F3!!"
    AudioClip: {fileID: 8300000, guid: d028cbe0b6aba92428a35faba7a248dd, type: 3}
    Volume: 0.85
  - Text: "\u7F8E\u3057\u3044\u30C3\u30C3!!"
    AudioClip: {fileID: 8300000, guid: bb8ddd9e45c97f547be81e31ffc2241d, type: 3}
    Volume: 0.85
  - Text: "\u80CC\u4E2D\u306B\u7FBD\u304C\u751F\u3048\u3066\u308B\u3088!!!"
    AudioClip: {fileID: 8300000, guid: a69db724768196046ad9d871f6e99078, type: 3}
    Volume: 0.85
  - Text: "\u80CC\u4E2D\u30E6\u30FC\u30E9\u30B7\u30A2\u5927\u9678!!!"
    AudioClip: {fileID: 8300000, guid: 5308583455ca19344b39a3b6a5a752e8, type: 3}
    Volume: 0.85
  _callPoints:
  - {fileID: 1610341285}
